{
  "rules": {
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['x', 'z', 'c', 'a', 'b', 't'])",
        "x": { ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7" },
        "z": { ".validate": "newData.isNumber() && newData.val() >= -48 && newData.val() <= 0" },
        "r": { ".validate": "newData.isNumber()" },
        "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6" },
        "a": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
        "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
        "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 9" },
        "st": { ".validate": "newData.isBoolean()" },
        "mv": { ".validate": "newData.isBoolean()" },
        "cl": { ".validate": "newData.isNumber()" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
